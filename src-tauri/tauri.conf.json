{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peta",
  "version": "0.0.1",
  "identifier": "app.peta.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics",
    "fileAssociations": [
      {
        "ext": [
          "peta"
        ],
        "name": "Peta distribution",
        "description": "Signed Peta files and gifts",
        "role": "Viewer",
        "mimeType": "application/x-peta"
      }
    ]
  }
}
