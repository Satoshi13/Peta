{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peta",
  "version": "0.0.1",
  "identifier": "app.peta.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Graphics and Design",
    "fileAssociations": [
      {
        "ext": [
          "peta"
        ],
        "name": "Peta distribution",
        "description": "Signed Peta files and gifts",
        "role": "Viewer",
        "mimeType": "application/x-peta"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp"
        ],
        "name": "Picture to cut out",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "peta"
        ]
      }
    }
  }
}
